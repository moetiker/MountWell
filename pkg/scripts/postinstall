#!/bin/bash
# Load the service for logged-in users, remove the predecessor "SMB Automount"
LABEL=ch.oetiker.mountwell
PLIST="/Library/LaunchAgents/$LABEL.plist"
APP="/Applications/MountWell.app"
OLD=ch.oetiker.smb-automount

chown root:wheel "$PLIST"
chmod 644 "$PLIST"

# SMB Automount (system-wide installation)
rm -f "/Library/LaunchAgents/$OLD.plist"
rm -rf "/Applications/SMB Automount.app"
pkgutil --forget "$OLD" >/dev/null 2>&1

# real users only: with nobody logged in (MDM, ssh) loginwindow runs as root
for uid in $(ps -axo uid=,comm= | awk '/loginwindow$/ && $1 >= 501 {print $1}' | sort -u); do
    user=$(id -un "$uid") || continue
    # as plist: the plain output wraps a path with spaces onto a second line
    home=$(dscl -plist . -read "/Users/$user" NFSHomeDirectory | plutil -extract dsAttrTypeStandard:NFSHomeDirectory.0 raw -o - -) || continue
    [ -d "$home" ] || continue
    # SMB Automount as single-user installation (first version)
    old="$home/Library/LaunchAgents/$OLD.plist"
    if [ -e "$old" ]; then
        launchctl bootout "gui/$uid" "$old" 2>/dev/null
        rm -f "$old" "$home/.local/bin/smb-automount"
    fi
    # Move the settings of MountWell 0.4 and earlier (~/.config/mountwell) or of SMB Automount
    # before the app looks for them (otherwise app or script do it at their next start).
    # mv keeps the owner.
    conf="$home/Library/Application Support/MountWell"
    for old in "$home/.config/mountwell" "$home/.config/smb-automount"; do
        if [ -d "$old" ] && [ ! -e "$conf" ] && [ -d "$home/Library/Application Support" ]; then
            mv "$old" "$conf"
        fi
    done
    launchctl bootout "gui/$uid/$LABEL" 2>/dev/null
    launchctl bootstrap "gui/$uid" "$PLIST"
    # open the configuration the first time, relaunch the app after an update
    relaunch="/var/run/$LABEL.relaunch.$uid"
    if [ -e "$relaunch" ] || [ ! -e "$conf/shares.conf" ]; then
        launchctl asuser "$uid" sudo -u "$user" open "$APP"
    fi
    rm -f "$relaunch"
done
exit 0
