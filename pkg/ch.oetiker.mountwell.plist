<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>ch.oetiker.mountwell</string>
    <key>ProgramArguments</key>
    <!-- a signed program of the app's team: only then does AssociatedBundleIdentifiers show the
         service as MountWell in System Settings → Login Items, not as from an unknown developer -->
    <array><string>/Applications/MountWell.app/Contents/MacOS/mountwell-agent</string></array>
    <key>AssociatedBundleIdentifiers</key>
    <array><string>ch.oetiker.mountwell.app</string></array>
    <key>LimitLoadToSessionType</key><string>Aqua</string>
    <!-- fires on network changes (Wi-Fi, Ethernet, many VPNs) -->
    <key>WatchPaths</key>
    <array><string>/Library/Preferences/SystemConfiguration</string></array>
    <!-- fallback for VPN clients that do not write the system configuration -->
    <key>StartInterval</key><integer>60</integer>
    <key>RunAtLoad</key><true/>
</dict>
</plist>
